# Conv2d(in, out, kernel, padding): 2D 컨볼루션 레이어. 채널 1 → 32 → 64
# MaxPool2d(kernel=2, stride=2): 2x2 크기의 최대값만 추출
# view: Flatten (차원을 일렬로 펴서 Linear 레이어로 넣기)
# fc1, fc2: Fully Connected 레이어 (DNN처럼 작동)
# forward: 데이터가 모델을 통과할 때 연산 과정을 정의class CNN(nn.Module): 
def __init__(self):
    super(CNN, self).__init__()
    self.conv1 = nn.Conv2d(1, 32, 3, padding=1)
    self.pool = nn.MaxPool2d(2, 2)
    self.conv2 = nn.Conv2d(32, 64, 3, padding=1)
    self.fc1 = nn.Linear(64 * 7 * 7, 128)
    self.fc2 = nn.Linear(128, 10)

def forward(self, x):
    x = self.pool(F.relu(self.conv1(x))) # (1,28,28) -> (32,14,14)
    x = self.pool(F.relu(self.conv2(x))) # (32,14,14) -> (64,7,7)
    x = x.view(-1, 64 * 7 * 7)           # Flatten
    x = F.relu(self.fc1(x))             # Fully Connected Layer 1
    x = self.fc2(x)                     # Fully Connected Layer 2